# Copy this file to .env and fill in ONE provider key.
# Anthropic is preferred automatically when ANTHROPIC_API_KEY is set.

# ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model selection is done via these env vars (the code never hardcodes a model).
# Set OPENAI_MODEL to a model your key can access.
OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: force a provider regardless of which keys are present ("anthropic" or "openai")
# LLM_PROVIDER=anthropic

# Optional pipeline tuning
# MAX_JD_PAGES=10
# TOP_K_PAIRWISE=5
# REQUEST_TIMEOUT=15
