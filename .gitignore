# secrets — never commit
.env

# generated pipeline outputs (regenerated by runs; not versioned)
outputs/cache/
outputs/latest/
outputs/*.log

# raw scraped JD HTML/JSON (regenerated by fetch)
data/raw/

# personal résumé input (contains PII) — each user provides their own (see README setup)
data/resume.md

# python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE / editor
.idea/
.vscode/
